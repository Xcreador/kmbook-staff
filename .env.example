# Supabase (Auth & API)
# NUNCA usar service_role en Staff. RLS es la autoridad.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Enlace a KMBOOK Business (SOLO servidor, sin NEXT_PUBLIC_).
# Origen https de Business, sin ruta, consulta ni credenciales (p. ej. https://business.example.com).
# Si falta o no es válido, Staff OCULTA los accesos a Business (cerrado por defecto: no hay URL por defecto).
# En local se admite http://localhost:<puerto>. Compatibilidad: NEXT_PUBLIC_BUSINESS_URL se lee si no existe esta.
# Ver README.md.
KMBOOK_BUSINESS_URL=
